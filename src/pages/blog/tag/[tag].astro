---
import Base from '@/layouts/Base.astro';
import BlogNav from '@/components/BlogNav.astro';
import PostCard from '@/components/PostCard.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { getPostSummaries, getAllTags, type PostSummary } from '@/lib/blog';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const [summaries, tags] = await Promise.all([
    getPostSummaries(),
    getAllTags(),
  ]);

  return tags.map(({ tag }) => ({
    params: { tag },
    props: {
      tag,
      summaries: summaries.filter((s) => s.post.data.tags.includes(tag)),
    },
  }));
}

interface Props {
  tag: string;
  summaries: PostSummary[];
}

const { tag, summaries } = Astro.props;
const count = summaries.length;
---

<Base
  title={`Posts tagged "${tag}" - ${site.name}`}
  description={`Blog posts tagged ${tag}.`}
>
  <BlogNav />

  <main class="px-4 pb-20">
    <header class="max-w-3xl mx-auto mb-14">
      <p class="text-sm text-muted">Tag</p>
      <h1 class="mt-1 text-4xl md:text-5xl font-bold text-strong">{tag}</h1>
      <p class="mt-4 text-body">
        {count}
        {count === 1 ? 'post' : 'posts'}
      </p>
    </header>

    <div
      class="max-w-6xl mx-auto grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3"
    >
      {
        summaries.map((summary, index) => (
          <PostCard summary={summary} index={index} />
        ))
      }
    </div>
  </main>

  <SocialLinks />
</Base>

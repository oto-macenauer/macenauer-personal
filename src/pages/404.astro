---
import Base from '@/layouts/Base.astro';
import { site } from '@/data/site';
---

<Base title={`Page not found - ${site.name}`} description="That page does not exist.">
  <main
    class="min-h-screen flex flex-col items-center justify-center px-4 text-center bg-gradient-to-br from-hero-from via-hero-via to-hero-to"
  >
    <p class="text-6xl md:text-8xl font-bold text-accent mb-4">404</p>
    <h1 class="text-3xl md:text-4xl font-bold text-strong mb-4">
      Page not found
    </h1>
    <p class="text-lg text-body max-w-md mb-10">
      That page does not exist, or it has moved.
    </p>
    <a
      href="/"
      class="px-8 py-3 bg-accent text-on-accent rounded-full hover:bg-accent-hover transition-colors duration-200 font-medium"
    >
      Back to home
    </a>
  </main>
</Base>

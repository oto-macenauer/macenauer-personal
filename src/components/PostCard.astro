---
import { Image } from 'astro:assets';
import { formatDate, isoDate, postPath, tagPath } from '@/lib/blog';
import type { PostSummary } from '@/lib/blog';

interface Props {
  summary: PostSummary;
  index?: number;
}

const { summary, index = 0 } = Astro.props;
const { post, readingTime } = summary;
---

<article
  class="group flex flex-col"
  data-reveal="up"
  style={`--reveal-delay: ${index * 80}ms`}
>
  <a href={postPath(post)} class="block">
    <div class="aspect-video rounded-xl overflow-hidden bg-surface-alt mb-5">
      <Image
        src={post.data.cover}
        alt={post.data.coverAlt}
        widths={[400, 800]}
        sizes="(max-width: 768px) 100vw, 400px"
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    </div>

    <h3
      class="text-xl font-semibold text-strong group-hover:text-accent transition-colors text-balance"
    >
      {post.data.title}
    </h3>
  </a>

  <p class="mt-2 text-body flex-1">{post.data.summary}</p>

  <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
    <time datetime={isoDate(post.data.date)} class="text-muted">
      {formatDate(post.data.date)}
    </time>
    <span class="text-subtle" aria-hidden="true">·</span>
    <span class="text-muted">{readingTime} min read</span>

    {
      post.data.draft && (
        <span class="rounded-full bg-accent-soft px-2 py-0.5 text-xs font-medium text-accent">
          Draft
        </span>
      )
    }
  </div>

  <div class="mt-3 flex flex-wrap gap-2">
    {
      post.data.tags.map((tag) => (
        <a
          href={tagPath(tag)}
          class="rounded-full border border-subtle px-2.5 py-0.5 text-xs text-muted hover:border-accent hover:text-accent transition-colors"
        >
          {tag}
        </a>
      ))
    }
  </div>
</article>
